<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <queries>
        <package android:name="com.cricfytv.sports" />
        <package android:name="org.jellyfin.androidtv" />
        <package android:name="tv.own.owntv" />
        <provider android:authorities="io.github.justinnewman.gameday.games" />
    </queries>
    <application android:allowBackup="false" android:usesCleartextTraffic="true"
        android:banner="@drawable/banner" android:icon="@drawable/icon"
        android:label="@string/app_name" android:supportsRtl="false" android:theme="@style/Screen">
        <activity android:name=".RowsActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>
        <provider android:name=".FilesProvider" android:authorities="com.gathin.newin.files"
            android:exported="true" android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
