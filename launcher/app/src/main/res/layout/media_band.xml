<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tabMovies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/media_tab_movies"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.22"
            android:textAllCaps="true"
            android:textColor="#B3FFFFFF"
            android:focusable="true"
            android:clickable="true"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

        <TextView
            android:id="@+id/tabSeries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/media_tab_series"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.22"
            android:textAllCaps="true"
            android:textColor="#66FFFFFF"
            android:focusable="true"
            android:clickable="true"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

        <TextView
            android:id="@+id/tabSports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/media_tab_sports"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.22"
            android:textAllCaps="true"
            android:textColor="#66FFFFFF"
            android:focusable="true"
            android:clickable="true"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/cardScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/cardRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </HorizontalScrollView>
</merge>
